(module wm.list)
(import "coil.arraylist" :use [ArrayList])

;;; Remove element `i` by moving the last element into its place. O(1); does
;;; not preserve order.
(defn remove-swap! [T] [(l (mut (ArrayList T))) (i i64)] (-> i64)
  (let [last (- (len l) 1)]
    (do
      (if (= i last) 0 (set! (mut l) i (get l last)))
      (match (pop! (mut l))
        (Some [_] 0)
        (None [] (panic "remove-swap!: empty list"))))))

;;; Remove element `i`, shifting later elements down. O(n); preserves order.
(defn remove-at! [T] [(l (mut (ArrayList T))) (i i64)] (-> i64)
  (let [(mut j) i]
    (do
      (while (< j (- (len l) 1))
        (do
          (set! (mut l) j (get l (+ j 1)))
          (set! j (+ j 1))))
      (match (pop! (mut l))
        (Some [_] 0)
        (None [] (panic "remove-at!: empty list"))))))
